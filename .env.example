# ── UNDEROXI Site — Environment Variables ──────────────────────
# Скопируй этот файл в .env и заполни значения.
# ВАЖНО: Никогда не коммить .env в репозиторий!

# ── Owner password (bcrypt hash) ────────────────────────────────
# Сгенерируй хеш командой: node scripts/hash-password.js
# Затем установи полученный хеш сюда.
OWNER_PASSWORD_HASH=$2a$10$...

# ── GitHub Personal Access Token ────────────────────────────────
# Создай токен в GitHub: Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Права: Contents: Read and write (только для файла team-data.json)
# Никогда не помещай этот токен в frontend-код!
GITHUB_TOKEN=github_pat_...

# ── GitHub Repository ───────────────────────────────────────────
# Укажи репозиторий в формате: владелец/репозиторий
GITHUB_REPO=your-username/underoxi-site

# ── GitHub file path (опционально) ──────────────────────────────
GITHUB_FILE_PATH=team-data.json

# ── GitHub branch (опционально) ─────────────────────────────────
GITHUB_BRANCH=main